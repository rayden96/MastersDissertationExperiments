# Results are gitignored — regenerable from runners, and can be large/Drive-mounted.
results/
# Exception: PreDiscovery/FocusedWork keeps its results in-repo (small, hand-curated).
!PreDiscovery/FocusedWork/results/
!PreDiscovery/FocusedWork/results/**

# Downloaded datasets (torchvision, sklearn, HuggingFace caches, etc.)
data/

# Claude Code harness local state (lock files, worktrees)
.claude/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
